---
import Base from '../layouts/Base.astro';
import ModCard from '../components/ModCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { site, home } from '../site.config';
import { allMods, itemsFor, url } from '../lib';

const mods = await allMods();
const totalItems = mods.reduce((n, m) => n + itemsFor(m).length, 0);
const { hero, intro, featured } = home;
const fMod = featured.mod ? mods.find((m) => m.id === featured.mod) : undefined;
const f = {
  title: featured.title || fMod?.data.name || '',
  text: featured.text || fMod?.data.tagline || '',
  image: featured.image || fMod?.data.banner || fMod?.data.icon,
  link: featured.link || (fMod ? url(`/mods/${fMod.id}/`) : ''),
  meta: fMod ? `${fMod.data.loaders.join(' · ')} · Minecraft ${fMod.data.minecraft} · ${itemsFor(fMod).length} items & blocks` : '',
};
---
<Base bare description={site.description} image={hero.image}>
  <section class="home-hero">
    {hero.video
      ? <video class="home-hero-media" src={url(hero.video)} poster={url(hero.image)} autoplay muted loop playsinline aria-hidden="true"></video>
      : <img class="home-hero-media" src={url(hero.image)} alt="" fetchpriority="high" />}
    <div class="home-hero-text">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title} <em>{hero.titleItalic}</em></h1>
      <p class="tagline">{hero.tagline}</p>
    </div>
    <a class="scroll-cue" href="#intro">Scroll ↓</a>
  </section>

  <section class="home-section home-intro" id="intro">
    <p class="eyebrow">{site.name}</p>
    <h2>{intro.title}</h2>
    <p>{intro.text}</p>
    <div class="home-stats">
      <div><strong>{mods.length}</strong><span>Mods</span></div>
      <div><strong>{totalItems}</strong><span>Items &amp; blocks</span></div>
      <div><strong>1.21.1</strong><span>Minecraft</span></div>
    </div>
  </section>

  {f.title && (
    <section class="home-section featured">
      <a class="featured-media" href={f.link || undefined}>{f.image && <img src={url(f.image)} alt={f.title} loading="lazy" />}</a>
      <div>
        <p class="eyebrow">{featured.label}</p>
        <h2>{f.title}</h2>
        <p>{f.text}</p>
        {f.meta && <p class="meta">{f.meta}</p>}
        {f.link && <a class="text-link" href={f.link}>{featured.linkLabel || 'Read more'} →</a>}
      </div>
    </section>
  )}

  <div class="home-ad"><AdSlot slot="inContent" /></div>

  <section class="home-section home-collections">
    <div class="head">
      <h2>Collections</h2>
      <a class="text-link" href={url('/mods/')}>View all</a>
    </div>
    <div class="mod-cards">{mods.map((m) => <ModCard mod={m} />)}</div>
  </section>
</Base>
