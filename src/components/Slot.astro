---
// One inventory slot. A tag ingredient cycles through the items it accepts.
import { lookup, tagName, url, type Ingredient } from '../lib';
interface Props { ing: Ingredient; count?: number; big?: boolean }
const { ing, count, big = false } = Astro.props;
const things = (ing?.ids ?? []).slice(0, 12).map(lookup);
const first = things[0];
const label = ing?.tag ? tagName(ing.tag) : first?.name;
const n = count ?? ing?.count;
const Tag = first?.href && !ing?.tag ? 'a' : 'span';
---
<Tag class:list={['slot', { big, cycle: things.length > 1 }]} href={Tag === 'a' ? url(first!.href!) : undefined} title={label} data-label={label}>
  {things.map((t, i) => t.icon
    ? <img src={url(t.icon)} alt={i === 0 ? label : ''} class:list={[{ on: i === 0, render: t.icon.includes('/renders/') }]} loading="lazy" />
    : <span class:list={['slot-missing', { on: i === 0 }]}>?</span>)}
  {n && n > 1 && <b class="slot-count">{n}</b>}
</Tag>

<script>
  // Tag ingredients ("Any Planks") show each item they accept in turn.
  setInterval(() => {
    for (const slot of document.querySelectorAll('.slot.cycle')) {
      const kids = [...slot.children].filter((c) => c.tagName !== 'B');
      const i = kids.findIndex((c) => c.classList.contains('on'));
      kids[i]?.classList.remove('on');
      kids[(i + 1) % kids.length]?.classList.add('on');
    }
  }, 1200);
</script>
