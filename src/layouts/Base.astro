---
import '@fontsource/pixelify-sans/500.css';
import '@fontsource/pixelify-sans/600.css';
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import Sidebar from '../components/Sidebar.astro';
import type { CollectionEntry } from 'astro:content';
import { site, ads } from '../site.config';
import { allMods, url } from '../lib';

interface Props { title?: string; description?: string; image?: string; wide?: boolean; bare?: boolean; mod?: CollectionEntry<'mods'> }
// bare: full-width page with no sidebars (used by the home page)
const { title, description = site.description, image, wide = false, bare = false, mod } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const mods = await allMods();
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);

// Top navigation dropdowns. Add or reorder tabs here.
type NavItem = { label: string; href: string; icon?: string; hint?: string; external?: boolean };
const nav: { label: string; items: NavItem[] }[] = [
  {
    label: 'Collections',
    items: [
      ...mods.map((m) => ({ label: m.data.name, href: url(`/mods/${m.id}/`), icon: m.data.icon ? url(m.data.icon) : undefined })),
      { label: 'All mods', href: url('/mods/'), hint: 'Overview of every mod' },
    ],
  },
  {
    label: 'Guides',
    items: [
      { label: 'Installing mods', href: url('/guides/installing-mods/'), hint: 'NeoForge, Fabric and launchers' },
      { label: 'Search the wiki', href: url('/search/'), hint: 'Items, blocks, features' },
    ],
  },
  {
    label: 'Community',
    items: [
      ...(site.links.curseforge ? [{ label: 'CurseForge', href: site.links.curseforge, external: true }] : []),
      ...(site.links.modpack ? [{ label: 'Official LuckyOwl Modpack', href: site.links.modpack, external: true }] : []),
      ...(site.links.discord ? [{ label: 'Discord', href: site.links.discord, external: true }] : []),
      { label: 'GitHub', href: site.links.github, hint: 'Source code and bug reports', external: true },
      { label: 'Report a bug', href: url('/guides/report-a-bug/') },
    ],
  },
  {
    label: 'About',
    items: [
      { label: 'About LuckyOwl', href: url('/about/'), hint: 'Who makes these mods' },
      { label: 'Privacy', href: url('/privacy/') },
    ],
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={url('/favicon.png')} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={new URL(url(image), Astro.site)} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  {ads.enabled && ads.client && (
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.client}`} crossorigin="anonymous"></script>
  )}
</head>
<body class:list={[{ 'is-bare': bare }]}>
  <header class="topbar">
    <a class="brand" href={url('/')}><img src={url('/favicon.png')} alt="" width="30" height="30" /> <span>LuckyOwl</span></a>

    <nav class="mainnav" aria-label="Main">
      {nav.map((group) => (
        <div class="dd">
          <button class="dd-btn" aria-haspopup="true" aria-expanded="false">{group.label} <svg class="caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></button>
          <div class="dd-menu" role="menu">
            {group.items.map((it) => (
              <a role="menuitem" href={it.href} class={path === it.href ? 'active' : ''} {...(it.external ? { rel: 'noopener', target: '_blank' } : {})}>
                {it.icon && <img src={it.icon} alt="" width="20" height="20" />}
                <span>{it.label}{it.hint && <small>{it.hint}</small>}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <form class="search" action={url('/search/')} method="get" role="search">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.4"/></svg>
      <input type="search" name="q" placeholder="Search the wiki" aria-label="Search the wiki" />
    </form>
    <button class="menu-btn" aria-label="Open menu" onclick="document.body.classList.toggle('nav-open')">☰</button>
  </header>

  {bare ? (
    <><Sidebar nav={nav} mods={mods} path={path} mobileOnly /><main class="bare" data-pagefind-body><slot /></main></>
  ) : (
  <div class="shell">
    <Sidebar nav={nav} mods={mods} path={path} mod={mod} />

    <main class:list={['content', { wide }]} data-pagefind-body>
      <AdSlot slot="header" />
      <slot />
      <AdSlot slot="footer" />
    </main>

    {!wide && (
      <aside class="rail">
        <slot name="rail" />
        <div class="sticky-ad"><AdSlot slot="sidebar" format="vertical" /></div>
      </aside>
    )}
  </div>
  )}

  <footer class="footer">
    <p>{site.name} · Made by {site.author}</p>
    <p><a href={url('/privacy/')}>Privacy</a> · <a href={url('/mods/')}>All mods</a>{site.links.discord && <> · <a href={site.links.discord}>Discord</a></>}{site.links.github && <> · <a href={site.links.github}>GitHub</a></>}</p>
    <p class="fine">Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.</p>
  </footer>
  <script>
    // Dropdowns: open on hover (desktop) via CSS, and on click/keyboard here.
    const dds = [...document.querySelectorAll('.dd')];
    const close = (except) => dds.forEach((d) => { if (d !== except) { d.classList.remove('open'); d.querySelector('.dd-btn').setAttribute('aria-expanded', 'false'); } });
    dds.forEach((dd) => {
      const btn = dd.querySelector('.dd-btn');
      btn.addEventListener('click', (e) => { e.stopPropagation(); const open = !dd.classList.contains('open'); close(dd); dd.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open)); });
    });
    document.addEventListener('click', () => close());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  </script>
</body>
</html>
